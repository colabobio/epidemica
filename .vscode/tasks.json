    {
      "label": "test: server",
      "type": "shell",
      "command": "mix format && mix compile --warnings-as-errors && mix test",
      "options": { "cwd": "${workspaceFolder}/server" },
      "problemMatcher": []
    },
    {
      "label": "test: models",
      "type": "shell",
      "command": "uv run pytest -q",
      "options": { "cwd": "${workspaceFolder}/models" },
      "problemMatcher": []
