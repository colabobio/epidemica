    {
      "label": "test: analysis",
      "type": "shell",
      "command": "uv run pytest -q",
      "options": { "cwd": "${workspaceFolder}/analysis" },
      "problemMatcher": []
    },
    {
      "label": "test: swift wire codec",
      "type": "shell",
      "command": "swift test",
