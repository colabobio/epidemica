# Copy to .env and fill in. Never commit the result.

# The public DNS name devices will reach. This ends up inside protocol_url, which the app fetches
# directly, so it must be the name the certificate is issued for.
PHX_HOST=study.example.org

# openssl rand -base64 48
POSTGRES_PASSWORD=

# Generate with: cd server && mix phx.gen.secret
SECRET_KEY_BASE=
