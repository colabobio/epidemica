<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Merged into the host app, so an institution embedding this module declares nothing by
         hand. The iOS side has no equivalent mechanism: Info.plist keys must be added to the app
         target, which is why ProximityPlugin checks for them at start and reports what is missing
         rather than failing silently. -->

    <!-- neverForLocation is what keeps a research app off the location permission entirely on
         Android 12 and later. A location prompt is a consent and app-review liability that this
         module does not need. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11 and earlier had no way to scan without location. Capped at API 30 so only
         devices that genuinely require it ever see the request. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application>
        <service
            android:name=".ProximityService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />
    </application>
</manifest>
