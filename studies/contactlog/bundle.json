        "max_gap_seconds": 600,
        "sample_credit_seconds": 90,
        "dropout_threshold_seconds": 75,
        "include_rssi": true,
        "include_min_distance": true,
        "include_pair_key": true,
        "include_device_class": true
      },
      "upload": {
        "min_duration_seconds": 0,
        "min_sample_count": 1
      }
    }
  },
  "sync": {
    "min_interval_seconds": 900
  }
}
