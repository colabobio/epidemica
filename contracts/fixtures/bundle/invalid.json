[
  {
    "case": "a bundle that names no modules",
    "why": "A study that activates nothing collects nothing. It would enroll successfully, show a healthy app, and produce an empty dataset that is only noticed at analysis.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "11111111-2222-4333-8444-555555555555",
      "title": "Collects nothing",
      "modules": {}
    }
  },
  {
    "case": "title missing",
    "why": "The title is what a participant reads when deciding whether they are in the right study, so it cannot be optional.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "11111111-2222-4333-8444-555555555555",
      "modules": {
        "proximity": {}
      }
    }
  },
  {
    "case": "an unrecognised top-level key",
    "why": "Closed at the top level so a researcher's typo fails loudly instead of silently leaving the intended setting at its default.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "11111111-2222-4333-8444-555555555555",
      "title": "Typo study",
      "modules": {
        "proximity": {}
      },
      "retention_days": 90
    }
  },
  {
    "case": "study_id is not a UUID",
    "why": "The study identifier seeds the proximity service UUID; a malformed one would silently isolate every device into its own study.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "contactlog",
      "title": "Contact logging pilot",
      "modules": {
        "proximity": {}
      }
    }
  },
  {
    "case": "a bundle version this schema does not define",
    "why": "An app must refuse a bundle it cannot fully interpret rather than apply the parts it recognises.",
    "instance": {
      "bundle_version": "2.0",
      "study_id": "11111111-2222-4333-8444-555555555555",
      "title": "From the future",
      "modules": {
        "proximity": {}
      }
    }
  },
  {
    "case": "module configuration is not an object",
    "why": "A module block is a configuration document. A bare true would leave the module's settings undefined while looking deliberate.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "11111111-2222-4333-8444-555555555555",
      "title": "Contact logging pilot",
      "modules": {
        "proximity": true
      }
    }
  },
  {
    "case": "sync interval below the floor",
    "why": "A device asked to sync every ten seconds would drain a participant's battery and achieve nothing the outbox does not already guarantee.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "11111111-2222-4333-8444-555555555555",
      "title": "Contact logging pilot",
      "modules": {
        "proximity": {}
      },
      "sync": {
        "min_interval_seconds": 10
      }
    }
  },
  {
    "case": "an empty title",
    "why": "Present but blank is the same failure as absent, and is easier to introduce by templating.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "11111111-2222-4333-8444-555555555555",
      "title": "",
      "modules": {
        "proximity": {}
      }
    }
  },
  {
    "case": "a twin that does not say what state it produces",
    "why": "Without state_uri the model's output cannot be validated and the app has nothing to check what it receives against.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "c0badf00-1111-4222-8333-444455556666",
      "title": "Epigame",
      "modules": {
        "proximity": {}
      },
      "twin": {
        "engine": "starsim",
        "population": 50
      }
    }
  },
  {
    "case": "a twin with no engine",
    "why": "A server that cannot tell which runtime to use would silently run nothing, which looks exactly like a study where nobody got infected.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "c0badf00-1111-4222-8333-444455556666",
      "title": "Epigame",
      "modules": {
        "proximity": {}
      },
      "twin": {
        "state_uri": "https://schemas.epidemica.info/state/epigame/1.0.0.json"
      }
    }
  },
  {
    "case": "a simulated population of nobody",
    "why": "A population of zero cannot contain the enrolled participants, so the bundle contradicts itself.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "c0badf00-1111-4222-8333-444455556666",
      "title": "Epigame",
      "modules": {
        "proximity": {}
      },
      "twin": {
        "engine": "starsim",
        "state_uri": "https://schemas.epidemica.info/state/epigame/1.0.0.json",
        "population": 0
      }
    }
  },
  {
    "case": "rules with no engine",
    "why": "A server cannot guess which economics a study meant; scoring nothing silently is worse than refusing.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "99999999-aaaa-4bbb-8ccc-dddddddddddd",
      "title": "No engine",
      "modules": {
        "proximity": {}
      },
      "rules": {
        "pars": {
          "healthy_points": 2
        }
      }
    }
  },
  {
    "case": "an unknown key in the rules block",
    "why": "Constants belong under `pars`; a stray sibling would be silently ignored and the study would score differently than its author intended.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "99999999-aaaa-4bbb-8ccc-dddddddddddd",
      "title": "Stray key",
      "modules": {
        "proximity": {}
      },
      "rules": {
        "engine": "epigame",
        "healthy_points": 2
      }
    }
  },
  {
    "case": "a schedule with no start",
    "why": "Without it the first day anchors to whenever the study was registered, so re-registering moves every boundary.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
      "title": "No start",
      "modules": {
        "proximity": {}
      },
      "schedule": {
        "days": 7
      }
    }
  },
  {
    "case": "a study of zero days",
    "why": "There would be no day one to run, and the app would show progress out of nothing.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
      "title": "Zero days",
      "modules": {
        "proximity": {}
      },
      "schedule": {
        "starts_at": "2026-09-07T06:00:00Z",
        "days": 0
      }
    }
  },
  {
    "case": "a start with no timezone",
    "why": "A local-looking timestamp is ambiguous by exactly the amount that decides which day a contact fell on.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
      "title": "Naive start",
      "modules": {
        "proximity": {}
      },
      "schedule": {
        "starts_at": "2026-09-07T06:00:00",
        "days": 7
      }
    }
  },
  {
    "case": "a seed block with no count",
    "why": "The whole point of the block is how many; defaulting it would decide the shape of the epidemic silently.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "cccccccc-dddd-4eee-8fff-000000000000",
      "title": "Seeded",
      "modules": {
        "proximity": {}
      },
      "twin": {
        "engine": "starsim",
        "state_uri": "https://schemas.epidemica.info/state/epigame/1.0.0.json",
        "seed": {
          "among": "virtual"
        }
      }
    }
  },
  {
    "case": "a negative number of seed infections",
    "why": "There is no coherent reading of it, and it would otherwise sit in a bundle until the first tick failed.",
    "instance": {
      "bundle_version": "1.0",
      "study_id": "cccccccc-dddd-4eee-8fff-000000000000",
      "title": "Seeded",
      "modules": {
        "proximity": {}
      },
      "twin": {
        "engine": "starsim",
        "state_uri": "https://schemas.epidemica.info/state/epigame/1.0.0.json",
        "seed": {
          "infections": -1
        }
      }
    }
  },
